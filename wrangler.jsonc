{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "patrickturner-net",
  "account_id": "851a39c5483b9aef842112771b5f8542",
  "compatibility_date": "2026-09-01",
  // Tiny Worker in front of the static files: redirects www to the apex.
  "main": "src/worker.js",
  "assets": {
    // Static files only; nothing outside ./public is ever uploaded.
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Send every request through the Worker first so www gets redirected
    // even for URLs that match a file.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "patrickturner.net", "custom_domain": true },
    { "pattern": "www.patrickturner.net", "custom_domain": true }
  ],
  // The site lives at patrickturner.net only: no *.workers.dev copy and no
  // per-version preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
